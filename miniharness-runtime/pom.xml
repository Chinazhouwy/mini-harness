<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chinazhouwy</groupId>
        <artifactId>mini-harness</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>miniharness-runtime</artifactId>
    <description>框架无关的 Harness 内核：Task/Run 状态、事件、Workflow 编译执行、能力路由与自进化引擎。只依赖 JDK 与 Jackson。</description>

    <dependencies>
        <!-- 与 study/study-spring-ai-alibaba 相同的处理：单独固定 Jackson 2.x，避免与宿主应用其他 Jackson 版本冲突。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.19.4</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
