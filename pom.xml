<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.chinazhouwy</groupId>
    <artifactId>mini-harness</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>MiniHarness</name>
    <description>三个 Agent 框架的隔离学习环境与自研 Harness 实践</description>

    <modules>
        <module>miniharness-core</module>
        <module>miniharness-runtime</module>
        <module>miniharness-plugin</module>
        <module>miniharness-spring-ai</module>
        <module>study/study-spring-ai</module>
        <module>study/study-agentscope</module>
        <module>study/study-spring-ai-alibaba</module>
        <module>app/task-assistant</module>
        <module>app/bot-team</module>
        <module>app/feishu</module>
    </modules>

    <!-- 父工程只统一 Java、测试与构建工具，不引入任一框架的 BOM 或运行时依赖。 -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <spring-ai-agent-utils.version>0.13.0</spring-ai-agent-utils.version>
        <agentscope.version>2.1.0-SNAPSHOT</agentscope.version>
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>
        <alibaba-spring-ai.version>1.1.2</alibaba-spring-ai.version>
        <junit.version>6.0.3</junit.version>
        <!-- live 需要真实模型或外部服务；manual 是耗时/交互式学习示例。 -->
        <excludedGroups>live,manual</excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration><parameters>true</parameters></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                        <!-- -pl 模块 -am -Dtest=类名 时，上游模块不必也有同名测试。 -->
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
